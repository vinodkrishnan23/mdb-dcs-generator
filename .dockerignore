# .dockerignore - Exclude unnecessary files from Docker build context

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next
out

# Git
.git
.gitignore

# IDE and editor files
.vscode
.idea
.cursor
*.swp
*.swo
*~

# Environment files
.env
.env*.local
.env.production

# Logs
*.log
logs

# OS files
.DS_Store
Thumbs.db

# Documentation and guides (with credentials)
README.md
COMPLETE_GUIDE.md
PROJECT_STATUS.md
prompt.md

# Scripts (may contain credentials)
scripts/

# CI/CD
.drone.yml

# Testing
coverage
.nyc_output

# Misc
.vercel
*.pem
CLEANUP_SUMMARY.md